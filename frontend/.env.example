# Optional overrides for a cross-origin deployment. In local dev these are
# unset and the Vite proxy (vite.config.ts) forwards /api and /prom instead.
#
# Base for the notiflow-api REST calls (defaults to same-origin "/api").
# If set, the backend must send CORS headers or be served same-origin.
# VITE_API_BASE=https://notiflow.example.com/api
#
# Base for the Prometheus HTTP API used by the dashboard (defaults to "/prom").
# VITE_PROM_BASE=https://prom.example.com
